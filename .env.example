# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=siac
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

DB_NAME=siac
DB_USER=siac_app
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

HTTP_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Proxy reverso Nginx / X-Accel-Redirect
USE_X_ACCEL_REDIRECT=True

# Segurança: em produção HTTPS, configure SECURE_COOKIES=True, SECURE_SSL_REDIRECT=True e HSTS.
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
